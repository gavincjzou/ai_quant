# LongPort OpenAPI Credentials
# 从长桥开发者平台获取: https://open.longportapp.com
# SDK v3+ 使用 LONGPORT_ 前缀（非 LONGBRIDGE_）
LONGPORT_APP_KEY=your_app_key_here
LONGPORT_APP_SECRET=your_app_secret_here
LONGPORT_ACCESS_TOKEN=your_access_token_here

# Optional: Custom endpoints (leave empty for defaults)
# LONGPORT_HTTP_URL=
# LONGPORT_QUOTE_WS_URL=
# LONGPORT_TRADE_WS_URL=

# System Settings
LOG_LEVEL=INFO
TRADE_MODE=paper  # paper | live
